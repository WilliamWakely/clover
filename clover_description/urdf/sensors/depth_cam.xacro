<?xml version="1.0" encoding="UTF-8"?>
<robot name="depth_camera" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="../depth_sensor.urdf.xacro"/>

  <xacro:macro name="depth_cam"
               params="name:=depth_cam parent x:=0 y:=0 z:=0 roll:=0 pitch:=0 yaw:=0 width:=320 height:=240 rate:=40">

    <joint name="${name}_joint" type="fixed">
      <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
      <parent link="${parent}"/>
      <child link="${name}_link"/>
    </joint>

    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.005 0.005 0.005"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.005 0.005 0.005"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.015"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="4.15e-6" iyy="2.407e-6" izz="2.407e-6" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>

    <!-- IMPORTANT: reference the LINK, not the joint -->
    <gazebo reference="${name}_link">
      <disableFixedJointLumping>true</disableFixedJointLumping>
      <preserveFixedJoint>true</preserveFixedJoint>

      <sensor type="depth" name="${name}">
        <always_on>true</always_on>
        <update_rate>${rate}</update_rate>
        <visualize>true</visualize>

        <camera>
          <horizontal_fov>${120 * pi / 180}</horizontal_fov>
          <image>
            <format>R8G8B8</format>
            <width>${width}</width>
            <height>${height}</height>
          </image>
          <clip>
            <near>0.02</near>
            <far>1000</far>
          </clip>
        </camera>

        <plugin name="${name}_depth" filename="libgazebo_ros_depth_camera.so">
          <alwaysOn>true</alwaysOn>
          <updateRate>${rate}</updateRate>

          <cameraName>${name}</cameraName>
          <frameName>main_camera_optical</frameName>

          <!-- Depth -->
          <depthImageTopicName>depth/image_raw</depthImageTopicName>
          <depthImageInfoTopicName>depth/camera_info</depthImageInfoTopicName>

          <!-- PointCloud -->
          <pointCloudTopicName>depth/points</pointCloudTopicName>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>
