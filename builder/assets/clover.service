[Unit]
Description=Clover ROS package
# ROS master hosted on desktop
After=network-online.target
Wants=network-online.target

[Service]
User=pi
Environment=ROS_MASTER_URI=http://192.168.50.150:11311
Environment=ROS_IP=192.168.50.111

ExecStart=/bin/bash -c ". /home/pi/catkin_ws/devel/setup.sh; \
                      exec stdbuf -o L roslaunch clover clover.launch --wait --screen --skip-log-check \
                      2> >(tee /tmp/clover.err)"

ExecStartPre=+rm /var/log/clover.log
StandardOutput=file:/var/log/clover.log
StandardError=file:/var/log/clover.log

[Install]
WantedBy=multi-user.target
